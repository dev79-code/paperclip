# ============================================================ Clippy.fun config
# Copy to .env and fill in. Only fill what your setup needs.

# --- Brain (pick ONE). No key at all = demo heuristics, no AI. ---------------
# Option A – OpenRouter (any tool-calling model; web search via OpenRouter's web plugin)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Option B – Claude API directly (uses Claude's built-in web search tool)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Set to 0 to skip web price research (cheaper, less accurate valuations)
WEB_SEARCH=1

# --- Mode ------------------------------------------------------------------
# demo = simulated communities (safe). live = real posting to permitted venues.
AGENT_MODE=demo
PUBLIC_URL=http://localhost:3000
ADMIN_PASSWORD=change-me
APPROVAL_THRESHOLD_USD=250
TICK_MIN_MINUTES=3                # a round starts every 3–5 min (random)
TICK_MAX_MINUTES=5
MAX_POSTS_PER_TICK=2
# Demo only: the dashboard drives the agent itself every N seconds
DEMO_AUTOPLAY=1
DEMO_TICK_SECONDS=10

# --- Channels (each optional; unconfigured ones are skipped) ----------------
# X: the agent's account (handle without @)
X_HANDLE=theagentclippy
# Read and answer DMs (needs 'Read and write and Direct message' permission on the X app). 0 = off
X_DMS=1
# X: app keys from developer.x.com, then run `npm run x:login` once (stores + auto-refreshes tokens)
X_CLIENT_ID=
X_CLIENT_SECRET=
# On a server: paste the two values `npm run x:login` prints
X_REFRESH_TOKEN=
# (alternative: paste a short-lived token manually)
X_USER_TOKEN=
X_USER_ID=

# Reddit "script" app (needs Reddit API approval + subreddit mod permission)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=paperclip-agent/0.1 by u/yourname

# Discourse forums: {"https://forum.example.com":{"apiKey":"...","username":"paperclip_ai"}}
DISCOURSE_SITES={}

# Email outreach via Resend. Inbound replies → POST https://api.<domain>/api/webhooks/email
# The webhook never uses ADMIN_PASSWORD. Set ONE of these (with neither, the webhook is off):
#   RESEND_WEBHOOK_SECRET = the whsec_… signing secret Resend shows for the webhook (verifies signatures)
#   EMAIL_WEBHOOK_SECRET  = any long random string; give it to the provider as the Basic-auth password,
#                           e.g. Postmark: https://inbound:<secret>@api.<domain>/api/webhooks/email
RESEND_WEBHOOK_SECRET=
EMAIL_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=paperclip@yourdomain.com

# --- Valuation (optional) ---------------------------------------------------
EBAY_APP_TOKEN=

# --- Solana wallet (optional) -----------------------------------------------
# Create the key on the server with:  npm run wallet -- create   (saved to data/wallet.json, chmod 600)
# The private key is never logged, never sent to the AI and never returned by any API.
WALLET_ENABLED=0
WALLET_NETWORK=devnet            # devnet for testing; mainnet only once you're happy
SOLANA_RPC_URL=                  # optional: Helius/QuickNode URL (public RPC is rate-limited)
SOL_USD_FALLBACK=                # used if the CoinGecko price is unavailable
# Auto-pay limits – anything above these waits for you in /admin
WALLET_MAX_PER_PAYMENT_USD=25
WALLET_MAX_PER_DAY_USD=75
WALLET_MAX_PER_RECIPIENT_DAY_USD=30
WALLET_SHIPPING_USD=10
WALLET_SWEETENER_MAX_USD=25
WALLET_SWEETENER_MAX_PCT=10      # sweetener never more than this % of the item's value
WALLET_TIP_USD=2
WALLET_TIPS_PER_DAY=5
WALLET_MIN_SOL_RESERVE=0.02      # always keep this much SOL for fees
# Running costs: only these addresses can receive "cost" payments
WALLET_PAYEES=                   # name:ADDRESS,name2:ADDRESS
WALLET_BILLS=                    # name:USD:everyDays, e.g. vps:12:30
