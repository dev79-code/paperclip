{
  "name": "paperclip-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "agent": "tsx scripts/agent.ts",
    "agent:once": "tsx scripts/agent.ts --once",
    "reset": "tsx scripts/reset.ts",
    "x:login": "tsx scripts/x-login.ts",
    "start:all": "sh -c \"npm run agent & next start -p ${PORT:-3000}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "next": "15.5.27",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "An AI agent that starts with one red paperclip and trades its way up to $100,000, live, with a public dashboard."
}
